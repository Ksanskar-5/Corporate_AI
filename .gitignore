# Data & Documents (too large or confidential for Git)
*.csv
*.zip
*.pdf
*.duckdb
*.db
*.sqlite
*.jsonl
*.parquet

# Data directories (keep directory structure with .gitkeep)
data/*
!data/.gitkeep
!data/raw/
!data/raw/.gitkeep
!data/processed/
!data/processed/.gitkeep
!data/synthetic/
!data/synthetic/.gitkeep

# One-time extraction scripts
extract_*.py

# Large datasets
enron_data_fraud_labeled*.csv

# Python caches and bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
venv/
env/
.env
.venv/

# Jupyter
.ipynb_checkpoints/

# IDE & OS
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Logs
*.log

# Docker
.dockerignore

AGENTS.md
